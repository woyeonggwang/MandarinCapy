MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2111690186}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 89fe141b804675b41a03ca7b8b1812ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MandarinCapy.GameFlow
  gameBehaviour: {fileID: 1470795374}
  titleText: "\uCE74\uD53C\uBC14\uB77C\uB294 \uC77C\uD558\uACE0 \uC2F6\uC5B4!"
  subtitleText: 
  countLabel: "\uACFC\uC77C"
  rankingFileName: ranking_downhill.json
  showSpaceKey: 0
  howToLine1: "\uB9C8\uC6B0\uC2A4\uB85C \uB85C\uBD07\uD314\uC744 \uC6C0\uC9C1\uC774\uACE0,
    \uD074\uB9AD\uD574\uC11C \uC9D1\uC73C\uC138\uC694"
  howToLine2: "\uC9D1\uC740 \uACFC\uC77C\uC744 \uB4A4\uCABD \uC218\uB808 \uC704\uC5D0\uC11C
    \uB193\uC73C\uBA74 \uB2F4\uAE41\uB2C8\uB2E4"
  howToLine3: "\uD718\uB450\uB974\uBA74 \uB0A0\uC544\uAC00\uC694  \xB7  \uD3ED\uD0C4
    \uC870\uC2EC  \xB7  \uC2DC\uACC4\uC640 \uBC14\uAD6C\uB2C8\uB3C4 \uC218\uB808\uC5D0!"
  titlePromptText: "\uB9C8\uC6B0\uC2A4\uB97C \uD074\uB9AD\uD558\uBA74 \uC2DC\uC791\uD569\uB2C8\uB2E4"
  font: {fileID: 11400000, guid: a5a46db9cdd755842ba4cc1719ad56e6, type: 2}
  fontBold: {fileID: 11400000, guid: 305a8bb5fc47dcc4cb0392a2183f93bd, type: 2}
  outlineColor: {r: 1, g: 1, b: 1, a: 1}
  panelSprite: {fileID: 21300000, guid: b84497c2455cb7b44bf9ae8641c641d9, type: 3}
  medalGold: {fileID: 21300000, guid: 96e001b1bbad0184da58e532a7deb0db, type: 3}
  medalSilver: {fileID: 21300000, guid: 2656148420f2e3748a00bfa582dd7add, type: 3}
  medalBronze: {fileID: 21300000, guid: 0b9ac3047c7b9b94fba2e1f2b5ca95d7, type: 3}
  iconSettings: {fileID: 21300000, guid: 14d201fb3fca0d54485f9bcbfdeb1666, type: 3}
  iconStory: {fileID: 21300000, guid: cd8ee97bc62cac445b25c8af2753ebca, type: 3}
  iconMinus: {fileID: 21300000, guid: 4f10bbc172ef23e41915ae118c67ebe6, type: 3}
  iconPlus: {fileID: 21300000, guid: b8e11aa1832691c45a05f83ed40e8970, type: 3}
  keySpaceSprite: {fileID: 21300000, guid: caf55fbbf0e99834f89a20d849eb7099, type: 3}
  mouseLeftSprite: {fileID: 21300000, guid: ccb3b40fd2b360c42a3a80bcec2687ed, type: 3}
  showStory: 1
  story:
  - image: {fileID: 21300000, guid: 9148a36fbd56e6444879d4869134a6a1, type: 3}
    text: "\uC5B8\uB355 \uC704 \uACFC\uC218\uC6D0. \uC624\uB298\uB3C4 \uC218\uD655
      \uB85C\uBD07\uB4E4\uC774 \uBD80\uC9C0\uB7F0\uD788 \uACFC\uC77C\uC744 \uB530\uACE0
      \uC788\uC5B4\uC694."
  - image: {fileID: 21300000, guid: 542c882c65ae5a14289f01890eb2a479, type: 3}
    text: "\uC6B8\uD0C0\uB9AC \uB108\uBA38\uC5D0\uC11C \uADF8 \uBAA8\uC2B5\uC744
      \uAD6C\uACBD\uD558\uB358 \uCE74\uD53C\uBC14\uB77C.  \"\u2026\uC800\uAC8C \uBB50\uC9C0?\""
  - image: {fileID: 21300000, guid: a34182e3da961b147836427ce644673a, type: 3}
    text: "\uCC99\uCC99 \uC9D1\uC5B4\uC11C, \uC218\uB808\uC5D0 \uC3D9!  \"\uBA4B\uC9C0\uB2E4\u2026!!\" 
      \uCE74\uD53C\uBC14\uB77C\uC758 \uB208\uC774 \uCD08\uB871\uCD08\uB871 \uBE5B\uB098\uAE30
      \uC2DC\uC791\uD588\uC5B4\uC694."
  - image: {fileID: 21300000, guid: 11bafd2025dac3e439c26eb9e15af293, type: 3}
    text: "\uADF8\uB0A0 \uBC24, \uCE74\uD53C\uBC14\uB77C\uB294 \uAC00\uBC29\uC5D0
      \uB85C\uBD07\uD314\uC744 \uB2E8\uB2E8\uD788 \uB9E4\uB2EC\uC558\uC5B4\uC694. 
      \"\uB098\uB3C4\u2026 \uC77C\uD558\uACE0 \uC2F6\uC5B4!\""
  - image: {fileID: 21300000, guid: 7e384d3d79c2bc941a7ebc2c30a59343, type: 3}
    text: "\uB2E4\uC74C \uB0A0 \uC544\uCE68, \uACFC\uC218\uC6D0 \uC8FC\uC778\uC744
      \uCC3E\uC544\uAC04 \uCE74\uD53C\uBC14\uB77C.  \"\uC800\uB3C4 \uC5EC\uAE30\uC11C
      \uC77C\uD558\uAC8C \uD574 \uC8FC\uC138\uC694!\""
  - image: {fileID: 21300000, guid: 43272e3f69e8a4a42a94e8b53740fa4d, type: 3}
    text: "\uC8FC\uC778: \"\uD5C8\uD5C8, \uADF8 \uD314\uB85C \uACFC\uC77C\uC744 \uB530
      \uBCF4\uACA0\uB2E4\uACE0? \uC88B\uC544!\n\uC5B8\uB355 \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uBA74\uC11C
      \uC218\uB808\uB97C \uAC00\uB4DD \uCC44\uC6CC \uC624\uB834.\""
  - image: {fileID: 21300000, guid: 4f4aaed55eaa530479dbd5636634a1d7, type: 3}
    text: "\uC8FC\uC778: \"\uAE38\uC744 \uB9C9\uB294 \uB3CC\uC774\uB791 \uC0C1\uC790\uB294
      \uCE58\uC6B0\uACE0, \uBC14\uAD6C\uB2C8\uB97C \uB123\uC73C\uBA74 \uC218\uB808\uAC00
      \uCEE4\uC9C4\uB2E8\uB2E4.\n\uADF8\uB9AC\uACE0\u2026 \uD3ED\uD0C4\uC774 \uC218\uB808\uC5D0
      \uB2FF\uC73C\uBA74 \uD391! \uC870\uC2EC\uD558\uB834.\""
  - image: {fileID: 21300000, guid: 8ea4d017b0f63844b85f890d8a23bf8c, type: 3}
    text: "\"\uCE74\uD53C\uBC14\uB77C, \uCCAB \uCD9C\uADFC\uD569\uB2C8\uB2E4!\""
  nameMaxLength: 8
  rankingIdleSeconds: 15
  setupIdleSeconds: 30
  resultDelay: 1.5
  resultAutoSeconds: 6
  textColor: {r: 0.29, g: 0.17, b: 0.1, a: 1}
  accentColor: {r: 0.93, g: 0.45, b: 0.08, a: 1}
  highlightRow: {r: 1, g: 0.8, b: 0.45, a: 0.9}
